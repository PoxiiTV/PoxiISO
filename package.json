{
  "name": "poxiiso",
  "version": "1.0.0",
  "description": "PoxiISO: USB multi-ISO basado en Ventoy",
  "main": "dist/main/main.js",
  "license": "GPL-3.0",
  "scripts": {
    "build": "tsc -p . && npm run build:renderer && node scripts/copy-assets.mjs",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "engine": "node scripts/fetch-engine.mjs && npm run plugson",
    "plugson": "python plugson/build.py && python plugson/build.py --lang en",
    "dev": "npm run build && electron .",
    "dist": "npm run build && npm run plugson && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
